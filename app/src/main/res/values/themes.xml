<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Knotwork" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
        Platform splash theme (Android 12+ splash screen API).

        Shows the brand mark on its light or dark launch background while the
        process boots and Compose installs its first
        frame. `postSplashScreenTheme` swaps to the regular app theme as soon
        as `installSplashScreen()` releases its keep-on-screen condition.
        The system vector and loading surface use the same ordered strokes.
    -->
    <style name="Theme.App.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_startup_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_animated_logo</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.Knotwork</item>
    </style>
</resources>
