    <string name="run_ceiling_pause_body_steps" tools:ignore="PluralsCandidate">本次运行已耗尽允许的所有步数。你可以让它继续运行 %1$,d 步，或在此停止。</string>
    <string name="run_ceiling_pause_body_tokens" tools:ignore="PluralsCandidate">本次运行已耗尽允许的所有 token。你可以让它继续消耗 %1$,d token，或在此停止。</string>
    <string name="run_ceiling_pause_continue" tools:ignore="PluralsCandidate">继续（+%1$,d）</string>
    <string name="run_ceiling_pause_stop">停止运行</string>
    <string name="run_ceiling_pause_notification_title">某项运行正在等待你操作</string>
    <string name="run_ceiling_pause_notification_text_steps" tools:ignore="PluralsCandidate">已使用 %1$,d / %2$,d 步。点按以决定是否继续运行。</string>
    <string name="run_ceiling_pause_notification_text_tokens" tools:ignore="PluralsCandidate">已使用 %1$,d / %2$,d token。点按以决定是否继续运行。</string>
